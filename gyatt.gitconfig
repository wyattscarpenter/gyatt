# This is gyatt. See https://github.com/wyattscarpenter/gyatt
# If you modify any of these lines (without making a pull request with the new changes to gyatt (or, I suppose, removing these comment lines so that this file no longer claims to be gyatt)), then for your own sake as well as mine I recommend you leave a comment by the option with YOUR NAME and why you've done what you've done. This will help you later if you need to locate problems.
# This file is alphabetized for quick reference (normal gitconfig files are not alphabetized — they are simply in whatever chronological order the options were set from the command line — but this one was written by hand, so I did alphabetize it). First by section, then within each section by each option. This means you will probably want to skip past the [alias] section at first to check out the options at the bottom, which are likely to be more important to you.
# See also: https://git-scm.com/docs/git-config#_configuration_file
[alias]
	abandon = reset --hard @{upstream} # Abandon the local copy and switch to origin. # Upon hearing about this command, Alex Chang remarked "abandoning my gyatt for the gittler".
	addx = git add --chmod=+x
	amend = commit --amend --no-edit # Note that this does not amend with unstaged changes, which is what I want half the time, but half the time is not what I want.
	amendall = commit -a --amend --no-edit # This also amends using the unstaged changes, which is what I want half the time, but half the time is not what I want.
	amendallall = ! git add -A ; git commit -a --amend --no-edit # This also amends using untracked files, which are now tracked. This is rarely wanted, but sometimes convenient.
	b = branch --verbose
	bash = ! bash -c # This allows me to execute commands in the bash that comes bundled with git-for-windows, if need be (the need is quite rare. Note that you typically have to quote the argument to this. Eg, git bash "python -m rich". Because otherwise they're just further arguments to bash I guess.
	be = ! git-be
	blone = clone --filter=blob:none # blobless clone; good for working casually with repos with large files in history. For more info, see https://github.blog/open-source/git/get-up-to-speed-with-partial-clone-and-shallow-clone/ #see also: scone. # part of me wants to name this command "plone", but so far I have resisted the urge.
	br = b
	blast = ! git-blast
	c = commit # see also: cm, cam, cum, gacm.
	cam = commit --all --message
	cd = checkout
	ch = checkout
	check = ! header STAGED && git diff --staged --check && header WORKING && git diff --check && header TRACKED && git diff --check $(git hash-object -t tree /dev/null) # Like git diff --check but for everything (although note that it will only report further errors once you've dealt with what's staged, then what's changed, then finally it will report on everything that's tracked). # Thanks be to http://peter.eisentraut.org/blog/2014/11/04/checking-whitespace-with-git
	cherrypick = cherry-pick
	#TODO/BUG: chmend moves you to git root for some reason? So local subdirectory relative paths don't work. I guess this might be a general property of (git for windows) git commands, since git bash bash also moves you there.
	chmend = ! git chmod "$@" && git amend && : # The null command at the end is needed so that amend doesn't get passed the wrong arguments.
	# As far as I can tell, no need for chmendall, because the point of git chmod is that the file mode change will then be staged...
	chmod = ! git-chmod
	chomd = chmod
	choose = patch # joke comment: invokes the axiom of choice.
	clear = git move @ #git extras also has a git clear, which takes priority over this, which is basically this + `git clean` (removes untracked files)
	close = "! git ch "$1"; curr_branch=`git branch --show-current`; git checkout `git config init.defaultBranch` && git branch --delete \"$curr_branch\" # like all deletes, this only deletes if merged. The concept behind this for me is that you've pushed to remote and then you close your local copy of the branch." #The first argument is optional, since a no-argument checkout is a no-op. # See also, plose, polose
	cm = commit --message # Like git gacm, but without the add --all step # See also: git cam, git cum
	conforg = config --show-origin
	create-github-repo = make-github-repo
	cum = ! git u && git commit --message # Fun fact: Latin for "with", which is what we're doing... committing "with" our new changes (for a limited sense of new changes). # See also: git u, git cam, git cm, git gacm # It's named git cum because it's like git cam except with update instead of all; there is, however, unfortunately no --update flag to commit, so the acronym makes a little less sense. We just have to git u beforehand, which I guess would make this, like, git gucm, if you want to think about it like that.
	c-p = cherry-pick # The hyphen exists to differentiate this command from git cp as short for copy (which can be found in Git Extras, for example) — although I almost never copy anything in git because between git ln and structuring projects well, you hardly need to. But it is good for, say, copying template files before you fill them out.
	d = ! header STAGED && git diff --word-diff=color --staged && header WORKING && git diff --word-diff=color #have to diff both the index and the working tree (both the stage and the file system (the part that git tracks, at least))
	du = ! printf \"%s (%s) $(git root)\\n\" `du --summarize --human-readable \"$(git root)\" | cut -f 1` `LC_NUMERIC=en_US.UTF-8 du --summarize --block-size=\"'KiB\" \"$(git root)\" | cut -f 1`
	dugc = ! git du && git gc --aggressive && git du
	f = fetch --all -j0
	fg = ! git f && git g # Not to be confused with the fg command of the unix world.
	fgg = ! git f && git gg # For some reason all of {fg, fgg, fggg} seem to do fgg? Also, on git for windows at least, it seems f doesn't print any output.
	fggg = ! git f && git ggg
	fsg = ! git f && git s && git gg # This is basically what I always want to do to look at the current state of a git repo. Could use a better alias, perhaps. Also collides in concept with git look, right now, a little bit.
	fixup = ! git reset --soft HEAD~1 && git commit --amend --no-edit # The "fixup" command from git rebase --interactive, but as an actual command you can do. # It's absolutely crazy how bad --interactive is at being... interactive... # Note that if you are rebasing interactively and in one of its "edit" steps, you will then have to git rebcont to progress the rebase.
	find-and-replace = !git grep -I --name-only "$1" | xargs sed -i "s/$1/$2/g"
	forsake = abandon
	g = "! git update-ref refs/heads/‡ORIG_HEAD‡ ORIG_HEAD ; git log --all --graph --pretty=format:'%C(bold blue)%as %Cgreen%ad%Creset %C(auto)%h%d %s %C(bold black)<%aN>%Creset' --date=format-local:'%H:%M (%a)' $@ ; git update-ref -d refs/heads/‡ORIG_HEAD‡ && :" #format inspired by https://gist.github.com/niun/ca61a37791ff1fdc9b33 # The ! git part is necessary, or else this does not work on Windows (replacing with double quotes will not cure the problem either). # TODO(?): I later decided to add a unix call as well for the net loc # The ORIG_HEAD malarkey just lets you see the ORIG_HEAD on the graph, which is not otherwise visible. The bracketed ref is only temporary, although of course the original ORIG_HEAD still exists as a pseudo-ref. I spent a long time trying different types of brackets and symbols for this ORIG_HEAD, and this was the best I got (if not constrained on my machine's terminal's character set, which seems to be Windows-1252, I might have gone with something like lenticular brackets). Putting it in heads/ is also not perfect, but only heads/ remotes/ and tags/ display at all, it seems, and of those the display for heads is most suitable. (Tags/ is right out, because that displays with "tag: "; and it seems more confusing to have ORIG_HEAD in remotes/ when actually the point is usually that it's the opposite of remote.) # The && : malarkey is just to stop arguments passing to the wrong thing, as usual.
	gacm = ! git add --all && git commit --message # This is my friend Gio's "Gack 'um" command. (note that arguments to gacm will be passed to git commit, starting at after --message, due to how git aliases work)
	gg = g -20 # Although the number 20 is fundamentally arbitrary here, and is chosen mostly just to comfortably fit in a default cmd window; and g is arbitrary and I just wanted to type it twice for fast typing; I like to amuse myself by pretending there is some great and noble correspondence between g, giga-, billion, twice million, and 20. Although my case is weakened by the fact that a mebi is 2^20, which is an even twentier number.
	ggg = g -40
	git = ! git # handles the ever-so-important `git git` case. Might fail (or do something unexpected) if you have git renamed to something else, I guess.
	gnome = rebase -i --rebase-merges --root # he's playing like a gnome / gently taking each seed and germinating it in a single sunlit jar placed alone upon a stump with just enough sky about it, before planting it alone in the perfect spot on the forest trails known only to him — Dayne #Update: rebasing like this is not something that git is good at in non-trivial cases. The gnome is bad.
	# The idea behind gull and gush is that I typically want to see the map before and after to be abreast of what changed.
	gull = ! git gg && git pull $@ && git gg && :
	gush = ! git gg && git push $@ && git gg && :
	l = log
	list-all-notes = ! git notes | cut -d' ' -f2 | xargs -ihash git log hash -1 # Yet another crucial piece of functionality git does not provide. Thanks for the workaround, BetaRide! https://stackoverflow.com/questions/20324417/git-get-all-notes-of-a-branch
	list-all-notes1 = ! git notes | cut -d' ' -f1 | xargs -I {} sh -c '(echo "-----------" && git show {})' #OK, so, uh, this name is bad, but sometimes you lose all the commits the notes pointed to, like because the setting that prevents that from happening isn't set so instead of just listing the commits you have to list the notes themselves. The regular list all notes will just give you bad object errors and you have to use this instead.
	ll = log -5
	ln = ! git-ln
	ls = ls-files --stage --abbrev -t --exclude-standard  ':(glob)*'
	make-github-repo = ! git-make-github-repo
	mb = move-branch
	move = reset --hard # The idea here is that you move the head (and current branch tip ref, naturally) to the specified commit. # TODO: ideally this should also be able to handle `git move from to`... also should abort if there are any unsaved changes, unless you --force. But this means I'll have to write my own shell script...
	move-br = move-branch
	move-branch = move
	netloc = ! git-netloc
	nocheckin = ! git-nocheckin # this sets up the nocheckin *system*. as opposed to git nocheckins, which checks for *tokens* of nocheckin. Unfortunately this is the opposite of git-todo. Oh well. #TODO: harmonize these? Probably in favor of the style of git-todo? Possibly call this set-nocheckin?
	nocheckins = grep --cached --line-number --ignore-case --word-regexp no""checkin # Checks for the existence of the forbidden string. The "" in the middle is just so that it doesn't pick up itself, which I do where I can (not on the left side, for example; it's impossible there).  # --cached is the old way of writing --staged, and we have to use it here, at least in my version of git. # Note that if git commit -am is called (and nocheckins is called in the pre-commit), the changes will be staged temporarily, then this command will run; so it does work correctly for pre-commit purposes. # "Of course, the pre-commit flash flash step paid ability window lil yatchy laptop!"
	npm-publish = ! git-npm-publish
	obv = ! git-obv # Honestly I don't know why we can't just put this script in this line directly. But it gives us "fatal: bad config line", at least in git version 2.45.2.windows.1
	ok = ! git status --short && git b && git stash list && git to""do && git no""checkins && git check #TODO: check if up-to-date with upstream? also check if all tags pushed to upstream? Also all git notes pushed to upstream? And all submodules are up to date?? And all subtrees (I guess you don't have to do anything special for git subtree, so maybe that's "for free")?? #this command checks if a repo is "ok", and lists any ways in which it is not "ok". “This world is imperfect; if only I could wipe away the impurities, and make it as beautiful as ME.” —https://www.youtube.com/watch?v=DN9DW4rrEjY #TODO: to be truly perfect, and finalized I think a git repo should have only one (non-archived? is that a concept in git?) branch; all other branches should be deleted or merged into master by the end of history. But I don't check that right now. #COULD: this kind of collides in concept with git look, maybe merge them or whatever. #COULD: also a truly "ok" repo would not have a most-recent version number ending in -dev, as that indicates a feature is half-finished. Note that this philosophy conflicts with, or actually come to think of it goes well with, my other philosophy, which is that immediately after X.Y.Z, the next commit promotes it to X.Y.Z-dev.
	onto = onto-interactive
	onto-interactive = ! echo 'OK, this isnt actually interactive, but the way you compose a git rebase --onto command is git rebase [from, but not including this commit] [to, including this commit (typically best if this is a branch name, so that this branch tip moves)] --onto [on to this commit (the branch you want to progress, whatever)]. Remember that this will crush merge structure unless (you include --rebase-merges or rebase.rebaseMerges is true)!'
	p = patch # Aliasing git p to patch when everyone loves doing git pull and git push may be a controversial move, and by controversial I mean genius. # See also, git_alias_p_meme.jpg
	patch = add --patch # see also: git add --interactive
	pick = patch
	pip-publish = ! git-pip-publish
	po = push --set-upstream origin HEAD
	pfush = push --force-with-lease --force-if-includes # the safest type of force push
	pffush = push --force-with-lease # the second-safest type of force push
	plose = ! git ch "$1" && git push && git close
	polose = ! git ch "$1" && git po && git close # I'm pretty sure this is "unsafe", in that if you don't know if there is another branch on the remote with this name you shouldn't use this. This is only for when you're quite sure, which I often have been. But usually you should just use plose and see if there's a push conflict, because that is "safe".
	r = remote -v
	reb = rebase
	rebcont = ! git diff --check && git add -u && git -c core.editor=true rebase --continue # continue a rebase or merge without editing the message. See https://stackoverflow.com/questions/43489971/how-to-suppress-the-editor-for-git-rebase-continue
	rebforsake = ! git checkout --theirs . && git rebcont # This command is for when there's a conflict in the middle of a rebase and you want to just let the other changes (say, from upstream) win instead of manually reconciling them. #todo: also make mergecont and mergeforsake? # todo: I'm not sure this is a good name for it. # TODO: also, I think this might be a bad command, because it's, well, it does what it says, which is kind of foolhardy...
	rebhelp = ! echo I always forget the order of rebase arguments. git rebase X rebases the current branch onto X. git rebase X Y checks out Y and then rebases it onto X.
	remove-file-from-history = ! git-remove-file-from-history
	replace-in-history = ! git-replace-in-history
	root = rev-parse --show-toplevel
	s = status
	sa = stash list
	scone = clone --depth 2 --shallow-submodules --recurse-submodules # This creates a shallow clone, including shallow (but actually-cloned, which is nice) submodules. We use depth 2 instead of the traditional depth 1 because I find it's often nice to have a little bit of room there, for various commands. # This is called "scone" because I quickly thought of many possible aliases, basically the regex sh?c?l?one, so I forced myself to only pick the best one (scone). # See also: blone. # shallow clone jutsu. is that anything.
	sh = show --word-diff=color #also might regret this alias one day as sh is also a shell.
	show-all-notes = list-all-notes
	show-all-notes1 = list-all-notes1
	sl = stash list # unfortunately, not the popular "steam locomotive" binary #might get rid of this later
	ss = s -s
	signoff = ! git-signoff # I get a mysterious "end-of-file" error if I try to inline this.
	st = s
	statuses = ! gits-status # todo: I should have a consistent rule on if I include aliases that would also be scripts added to path. For example, git-obv being both a script that git would find if you add the gyatt folder to the path and also an alias to said script, listed above. This comes to attention here because I'd like this to be both git-statuses and gits-status, the later of which won't be found on path by git. But this is an easy todo, really. (Currently, my answer is "yes", but I should ponder if my answer should be "no" for DRY or other reasons.) # It seems like maybe all of the scripts are going to have to be named git-whatever.sh, and then the alias sends whatever to ! git-whatever.sh, for the simple reason that otherwise git-for-windows will find git-whatever the file first, and will error on failing to execute it. #actually you can also fix that by putting a shebang at the top of the file, so I guess it's just a quirk of git. #But, anyway, I think they should all be git-whatever.sh for the normal reasons you want file extensions, and then alias to an invocation of that here. #On the other hand, maybe they should all be extensionless so that people can just copy those to /usr/bin/ if they just want that command specifically.
	sw = switch
	look = ! git-look.sh # Historical note for my own convenience: this used to be called git-survey, until that name got taken by an upstream command. # The concept of this command overlaps with git-ok a little. You could even joke that look is short for "long ok". Anyway, maybe I'll TODO: sort that out some day.
	t = tag
	text = ! git conforg alias."$1" || echo "No alias for" # This will show you the full text of the alias, much like git help, but also its origin.
	timend = ! GIT_COMMITTER_DATE="$1" git commit --amend --no-edit --date #amend, with a new time passed as an argument (it gets applied once as $1 and applied once as appended to the end of the list, where "--date" expects it as an argument). You can see the current AuthorDate and CommitDate with `git l --pretty=fuller -1`. Regular amend only adjusts the committer date (but always sets it to the present). Git is pretty picky about what date formats it accepts. The easiest for me is something like "2024-09-11 12:58:24". See https://git-scm.com/docs/git-commit#_date_formats for more.
	todo = grep --line-number --ignore-case --word-regexp to""do # The "" in the middle is just so that it doesn't pick up itself, which I do where I can (not on the left side, for example; it's impossible there).
	touch = ! touch "$@" && git add "$@" #TODO: this seems to create multiple files if I try to git touch a file with spaces on windows (eg `git touch "foo bar.txt"` makes foo and bar.txt).
	touchx = ! touch "$@" && git add --chmod=+x "$@"
	# TODO: I would like a "git undo" command that undoes the last git command (not to be confused with Git Extra's "git undo", which just removes the latest (n) commits, sadly) with full generality. Unfortunately this would be very hard to make. The closest thing would be moving to back in the reflog, which is better than nothing but still a poor substitute. So, I probably will never achieve git undo. Ah, well.
	u = add -u
	unstage = restore --staged
	w = whoami
	wh = whoami
	whoami = ! git config --get user.name && git config --get user.email
	whomami = whoami
[core]
	longpaths = true
	whitespace = incomplete-line
[commit]
	verbose = true
[credential]
	useHttpPath = true
[diff]
	algorithm = histogram #seems changing doesn't do anything, weird. Or maybe I just haven't noticed yet.
	wsErrorHighlight = all
[gc]
	auto = 0 # Disables automatic garbage collection. See Gyatt readme for more on why this is a good idea.
[init]
	defaultBranch = master
[notes]
	rewriteRef = refs/notes/* # Provisional default. See Gyatt readme for more info.
[rebase]
	rebaseMerges = true
[rerere]
	enabled = true
